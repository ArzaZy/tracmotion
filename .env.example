# TracMotion configuration. No secrets are required for Stage 2.
NEXT_PUBLIC_APP_NAME=TracMotion

# Server-only (never prefix with NEXT_PUBLIC_).
# "mock" = explicit MOCK adapter (default, produces no video).
# "real" = NOT implemented yet; jobs fail with a clear error.
TRACMOTION_RUNTIME_MODE=mock

# Future render worker (server-only). Leave empty for now.
# TRACMOTION_WORKER_URL=
# TRACMOTION_WORKER_TOKEN=
